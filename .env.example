# ---------------------------------------------------------------------------
# neo4j_dbRenovai_rpa — copie para .env e preencha (o .env NÃO vai para o git)
# ---------------------------------------------------------------------------

PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_SSLMODE=prefer

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Geocoders em ordem de tentativa. Opções: brasilapi, nominatim, mock, none
# Dica: adicione ',mock' em dev/testes caso o banco possua CEPs/endereços fictícios gerados por Faker.
GEOCODERS=brasilapi,nominatim
NOMINATIM_USER_AGENT=neo4j_dbRenovai_rpa (seu-email@exemplo.com)
NOMINATIM_INTERVALO_S=1.1
KNN_K=4
FATOR_TORTUOSIDADE=1.3
MAX_ARESTA_KM=50

CAPACIDADE_JANELA_MESES=3
FORNECE_JANELA_DIAS=90

TAMANHO_LOTE=500
